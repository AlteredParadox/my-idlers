APP_NAME=my-idlers
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=my_idlers
DB_USERNAME=my_idlers
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
# The Docker image runs a supervised worker and sets this to `database`, which
# takes password-reset mail off the request. `sync` (the default here for local
# work) sends inline: fine for development, but it holds a web worker for the
# length of the SMTP conversation and lets /forgot-password be timed to learn
# whether an account exists.
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Set to true when serving over HTTPS
SESSION_SECURE_COOKIE=false

# Comma-separated proxy IPs/CIDRs when behind a reverse proxy. Prefer the actual
# proxy address over '*': '*' trusts the X-Forwarded-* headers on every request,
# so anything that can reach the app directly picks the client IP it logs and
# throttles by, and the scheme/host it builds URLs from.
TRUSTED_PROXIES=

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
# smtps = implicit TLS and enforced (use with MAIL_PORT=465). Leaving this
# unset means opportunistic STARTTLS, which a network attacker can strip.
MAIL_SCHEME=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Registration cap: registration closes once this many users exist (0 = unlimited)
MAX_USERS=1

# Currency conversion rates endpoint (e.g. https://open.er-api.com/v6/latest/USD).
# Leave blank to disable conversion (1:1 fallback).
EXCHANGE_RATES_URL=

# Set to true to seed demo data alongside the core seeders
SEED_DEMO_DATA=false

# Only consulted when APP_ENV=production, where SEED_DEMO_DATA alone is not
# enough: the demo set creates a verified admin whose password is published in
# the README. Set this too only for a deliberate public demo instance.
ALLOW_DEMO_DATA_IN_PRODUCTION=false
